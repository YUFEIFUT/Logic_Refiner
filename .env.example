# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# MIMO_API_KEY: [已废弃] 不再被读取。请使用下方 LLM_* 配置。
# MIMO_API_KEY="your_mimo_api_key_here"

# LLM_PROVIDER: LLM 供应商标识。可选值：mimo / openai / deepseek / qwen / moonshot / zhipu / mistral / agnes / toter / opencode
LLM_PROVIDER="mimo"

# LLM_API_KEY: LLM 供应商的 API Key（必填）
LLM_API_KEY="your_llm_api_key_here"

# LLM_BASE_URL: LLM 供应商的 API 基础地址（必填，不含 /chat/completions 后缀）
# 各厂商参考值：
#   mimo     -> https://api.xiaomimimo.com/v1
#   deepseek -> https://api.deepseek.com/v1
#   qwen     -> https://dashscope.aliyuncs.com/compatible-mode/v1
#   moonshot -> https://api.moonshot.cn/v1
#   zhipu    -> https://open.bigmodel.cn/api/paas/v4
#   openai   -> https://api.openai.com/v1
#   mistral  -> https://api.mistral.ai/v1
#   agnes    -> https://apihub.agnes-ai.com/v1
#   toter    -> https://speed.toter.me/v1
LLM_BASE_URL="https://api.xiaomimimo.com/v1"

# LLM_MODEL: 使用的模型名称（必填）
LLM_MODEL="mimo-v2.5-pro"

# LLM_TEMPERATURE: 采样温度（可选，默认 0.8）
# LLM_TEMPERATURE="0.8"

# LLM_MAX_TOKENS: 单次生成的【最大输出】token 数（可选，不填则让 API 自决）。
# 注意：这是“输出上限”，通常远小于模型的“上下文窗口(context window)”。
# 例如 mistral-medium-3-5 上下文窗口约 262K，但单轮输出上限请以厂商文档为准（来源互相矛盾，约 8K 量级）。
# 一般用途填 8192~16384 即可；盲目填大值会拉高延迟与费用。切勿把上下文窗口大小当 max_tokens 填。
# LLM_MAX_TOKENS="8192"

# LLM_REASONING_DEFAULT: 可选。effort 型模型（如 Mistral）的默认推理档，
# 仅在调用方传 reasoning===true（未指定档位）时生效；toggle 型（MiMo）无意义。
# 配置层接受：none | minimal | low | medium | high | xhigh（启动校验用全局集合）
# 但各模型实际仅支持子集；不在子集内的档位会在运行时静默回退到登记表 default（不报错）。
# 例：mistral-medium-3-5 仅支持 high/none，填 medium/xhigh 等会回退 high。
# 不配则用登记表 default（Mistral=high）。
# LLM_REASONING_DEFAULT="high"

# ---- 切换到 Mistral 推理模型示例 ----
# LLM_PROVIDER="mistral"
# LLM_BASE_URL="https://api.mistral.ai/v1"
# LLM_MODEL="mistral-medium-3-5"
# LLM_API_KEY="<your_mistral_key>"
# mistral-medium-3-5 仅支持 reasoning_effort: high | none。
# 想开推理用 high（默认），想关推理用 none；填其他档位会报错。
# LLM_REASONING_DEFAULT="high"

# ---- 切换到 Agnes 2.0 Flash 推理模型示例 ----
# LLM_PROVIDER="agnes"
# LLM_BASE_URL="https://apihub.agnes-ai.com/v1"
# LLM_MODEL="agnes-2.0-flash"
# LLM_API_KEY="<your_agnes_key>"
# Agnes 思考模式为【纯开关、无强度档】：开 = chat_template_kwargs.enable_thinking:true
#   由调用方传 reasoning:true/false 控制，无需也不读 LLM_REASONING_DEFAULT（toggle 型无意义）。
# 思考内容返回在 message.reasoning_content，最终答案在 message.content。
# 思考模式下实测无温度约束（temperature:0 正常返回）。

# ---- 切换到 toter 聚合平台（gemini-3.1-pro）推理模型示例 ----
# LLM_PROVIDER="toter"
# LLM_BASE_URL="https://speed.toter.me/v1"
# LLM_MODEL="gemini-3.1-pro"
# LLM_API_KEY="<your_toter_key>"
# LLM_TEMPERATURE="0.7"
# LLM_MAX_TOKENS="65536"
# toter 是第三方聚合平台，OpenAI 兼容端点，支持多模型（gemini-3.1-pro 等）。
# 思考模式为【纯开关、无强度档】：开 = thinking:{type:"enabled"}（与 MiMo 同构）
#   由调用方传 reasoning:true/false 控制，无需也不读 LLM_REASONING_DEFAULT（toggle 型无意义）。
# 思考内容返回在 message.reasoning_content，最终答案在 message.content。
# 兼容层接受 thinking.budget_tokens 但实测不生效（reasoning_tokens 不受其约束），故不声明。
# 思考模式下实测无温度约束（temperature:0.7 正常返回）。
# 输出上限字段为 max_tokens（实测 max_completion_tokens 也接受，二选一，此处用 max_tokens）。

# ---- 切换到 opencode 本地代理（免费模型）示例 ----
# LLM_PROVIDER="opencode"
# LLM_BASE_URL="http://127.0.0.1:8787/v1"
# LLM_MODEL="deepseek-v4-flash-free"
# LLM_API_KEY="whatever"
# opencode 是本地代理（D:\my_software\get_api_from_opencode\proxy.js，默认端口 8787），
# 转接 opencode Zen 免费模型为 OpenAI 兼容 API；代理不校验 API Key（随便填）。
# 仅本地开发可用（Render 生产访问不到 127.0.0.1）；上游为蹭免费额度，随时可能限流，定位为本地省钱/备用。
# 已实测：支持 SSE 流式（逐 token + 思考链实时推送）；模型默认自带思考，
# 无需配置 LLM_REASONING_DEFAULT。可用模型列表：GET http://127.0.0.1:8787/v1/models

# ADMIN_TOKEN: 管理员模式访问令牌，用于查看和管理全部数据。
# 建议使用足够复杂的随机字符串。
ADMIN_TOKEN="your_secure_admin_token_here"
